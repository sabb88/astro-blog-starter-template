---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

<main>
  <!-- Hero Section -->
  <section class="hero">
    <h1>Hi, I’m Jan 👋</h1>
    <p>Social Media Manager & Content Creator based in Calamba, Laguna.</p>
    <a href="/portfolio" class="cta">View My Work</a>
  </section>

  <!-- About Snapshot -->
  <section class="about">
    <h2>About Me</h2>
    <p>
      I help brands grow online through authentic content, video editing, and
      social media strategy. With 5+ years of experience, I’ve managed campaigns
      that drive engagement and results.
    </p>
  </section>

  <!-- Portfolio Highlights -->
  <section class="portfolio">
    <h2>Featured Projects</h2>
    <div class="grid">
      <div class="card">Project 1</div>
      <div class="card">Project 2</div>
      <div class="card">Project 3</div>
    </div>
    <a href="/portfolio" class="cta">See Full Portfolio</a>
  </section>

  <!-- Services -->
  <section class="services">
    <h2>Work With Me</h2>
    <ul>
      <li>📱 Social Media Management</li>
      <li>🎬 Video Editing (TikTok, Reels, Shorts)</li>
      <li>🎨 Graphic Design & Branding</li>
    </ul>
    <a href="/work-with-me" class="cta">Let’s Collaborate</a>
  </section>
</main>

<style>
  main {
    padding: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .hero {
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(to bottom, #ffffff, #f8f9fa);
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    background-color: #0077ff;
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s ease;
  }

  .cta:hover {
    background-color: #005fcc;
  }

  section {
    margin-top: 3rem;
  }

  .grid {
    display: flex;
    gap: 1rem;
  }

  .card {
    flex: 1;
    background: #f0f0f0;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }
</style>
		<Footer />
	</body>
</html>
