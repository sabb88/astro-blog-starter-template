---
import Header from "../components/Header.astro";
---

<Header />

<main class="front-page">
  <!-- Hero -->
  <section class="hero">
    <h1>Let Your Brand Do the Storytelling</h1>
    <p>Win customers, increase sales, and become memorable through story-driven designs & strategies.</p>
    <a href="/contact" class="cta">Let’s Talk</a>
  </section>

  <!-- Services -->
  <section class="services">
    <h2>Services</h2>
    <div class="grid">
      <div class="card">Branding Strategy</div>
      <div class="card">Logo Design</div>
      <div class="card">Web Design & Development</div>
      <div class="card">Motion Design</div>
      <div class="card">Print & Package Design</div>
      <div class="card">Shirt & Merchandise Design</div>
      <div class="card">Email Marketing Design</div>
    </div>
  </section>

  <!-- About -->
  <section class="about">
    <h2>About</h2>
    <p>More than visuals, our goal is to infuse purpose into your brand. We aim for real connections, loyal fans, and a thriving community.</p>
  </section>

  <!-- Testimonials -->
  <section class="testimonials">
    <h2>Testimonials</h2>
    <blockquote>
      “Working with Jan was very easy. He created our logo, fonts, colors, and overall personality just as I visualized it.”
      <footer>— Client Name, Business</footer>
    </blockquote>
    <blockquote>
      “Jan’s attention to detail and branding process brought our vision to life way more than expected.”
      <footer>— Client Name, Business</footer>
    </blockquote>
  </section>

  <!-- Portfolio -->
  <section class="portfolio">
    <h2>Works</h2>
    <div class="grid">
      <div class="card">Project 1</div>
      <div class="card">Project 2</div>
      <div class="card">Project 3</div>
    </div>
    <a href="/portfolio" class="cta">More Projects</a>
  </section>
</main>

<style>
  .front-page { padding: 2rem; max-width: 1200px; margin: 0 auto; font-family: 'Poppins', sans-serif; }
  .hero { text-align: center; padding: 4rem 2rem; background: linear-gradient(to bottom, #fff, #f8f9fa); border-radius: 12px; }
  .cta { display:inline-block; margin-top:1rem; padding:0.75rem 1.5rem; background:#0077ff; color:#fff; border-radius:8px; text-decoration:none; font-weight:600; }
  .grid { display:flex; flex-wrap:wrap; gap:1rem; }
  .card { flex:1 1 250px; background:#f0f0f0; padding:1.5rem; border-radius:8px; text-align:center; }
  .testimonials blockquote { background:#f9f9f9; padding:1rem; border-left:4px solid #0077ff; margin-bottom:1rem; }
</style>
